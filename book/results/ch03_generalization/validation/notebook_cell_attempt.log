// These generated CSVs have plain, unquoted numeric/identifier fields.
fn read_study_csv(path: &str) -> Result<Vec<std::collections::BTreeMap<String, String>>, Box<dyn std::error::Error>> {
    let text = std::fs::read_to_string(path)?;
    let mut lines = text.lines();
    let header: Vec<_> = lines.next().ok_or("missing header")?.split(',').map(str::to_owned).collect();
    let mut rows = Vec::new();
    for line in lines {
        let fields: Vec<_> = line.split(',').map(str::to_owned).collect();
        if fields.len() != header.len() { return Err("invalid generated CSV row".into()); }
        rows.push(header.iter().cloned().zip(fields).collect());
    }
    Ok(rows)
}
fn across_runs(values: &[f64]) -> (f64, f64) {
    let mean = values.iter().sum::<f64>() / values.len() as f64;
    let sd = (values.iter().map(|v| (v-mean).powi(2)).sum::<f64>() / (values.len()-1) as f64).sqrt();
    (mean, sd)
}
let study_runs = read_study_csv("../book/results/ch03_generalization/runs.csv")?;
assert_eq!(study_runs.len(), 60);
for row in &study_runs {
    assert_eq!(row["protocol"], "controlled_v1");
    assert_eq!(row["training_rollouts"], "32768");
    assert_eq!(row["heldout_episodes"], "100");
}
let condition_ids = ["full_cma_1", "full_cma_16", "full_ff_neat_1", "full_ff_neat_16", "partial_ff_neat_16", "partial_recurrent_neat_16"];
println!("Condition                        train mean | held-out mean ± run SD | mean horizon successes /100");
for condition in condition_ids {
    let rows: Vec<_> = study_runs.iter().filter(|r| r["condition"] == condition).collect();
    assert_eq!(rows.len(), 10);
    let training: Vec<f64> = rows.iter().map(|r| r["train_mean"].parse().unwrap()).collect();
    let heldout: Vec<f64> = rows.iter().map(|r| r["heldout_mean"].parse().unwrap()).collect();
    let successes: Vec<f64> = rows.iter().map(|r| r["heldout_horizon_hits"].parse().unwrap()).collect();
    let (mean, sd) = across_runs(&heldout);
    println!("{:<32} {:>8.2} | {:>8.2} ± {:>7.2} | {:>6.2}", condition, across_runs(&training).0, mean, sd, across_runs(&successes).0);
}
let recurrent_rows: Vec<_> = study_runs.iter().filter(|r| r["condition"] == "partial_recurrent_neat_16").collect();
let reset_returns: Vec<f64> = recurrent_rows.iter().map(|r| r["ablation_mean"].parse().unwrap()).collect();
let paired_deltas: Vec<f64> = recurrent_rows.iter().map(|r| r["heldout_mean"].parse::<f64>().unwrap() - r["ablation_mean"].parse::<f64>().unwrap()).collect();
println!("Same recurrent policies, state reset each action: {:?} (mean, run SD)", across_runs(&reset_returns));
println!("Paired retained-minus-reset return: {:?} (mean, run SD)", across_runs(&paired_deltas));
